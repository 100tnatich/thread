# Copie ce fichier en .env (chmod 600 .env) et remplis-le. Jamais dans git.
# Conventions: ~/infra/CONVENTIONS.md (§3 ports, §6 .env).
# Pas de DOMAIN / ACME_* / DDNS_* ici: ils vivent dans ~/infra/gateway/.env.

# --- Identité (alloué dans ~/infra/JOURNAL.md) -----------------------------
APP_SLUG=thread
APP_NUMBER=01

# --- Ports de DÉVELOPPEMENT (formule: CONVENTIONS.md §3.2) ------------------
# Jamais de valeur « à l'œil »: run.sh refuse de démarrer si elles ne
# correspondent pas à APP_NUMBER.
PORT_WEB=5201
PORT_API=8101
PORT_E2E_WEB=5301
PORT_E2E_API=8301

# --- Obligatoire en production ---------------------------------------------

# Secret de signature des cookies de session, 32 caractères minimum.
# Génère-le avec:  openssl rand -hex 32
# Le changer déconnecte toutes les sessions existantes.
SESSION_SECRET=

# --- Compte (premier démarrage) --------------------------------------------

# Si ADMIN_PASSWORD est défini et qu'aucun compte n'existe, il est créé au
# démarrage (12 caractères minimum). VIDE cette variable juste après, puis
# change le mot de passe depuis la page Réglages.
ADMIN_USER=nate
ADMIN_PASSWORD=

# --- LLM: crédit API --------------------------------------------------------

# Clé OpenRouter (https://openrouter.ai/keys): correction par IA des réponses
# libres (libre_llm) et des rédactions (redaction). Le nom est lu sans tenir
# compte de la casse (OpenRouter_API_KEY fonctionne aussi).
OpenRouter_API_KEY=

# La correction par IA n'est réelle que si cette variable vaut 1 ET qu'une clé
# OpenRouter est présente. Sinon: auto-évaluation, aucune dépense.
FLASHCARDS_JUGE_REEL=0

# Modèle du juge. Liste fermée (budget.py, TARIFS_JUGE):
# anthropic/claude-haiku-5.5 (défaut, ~0,0002 USD par correction)
# ou google/gemini-2.5-flash.
FLASHCARDS_JUGE_MODELE=

# La vraie API Anthropic n'est appelée que si cette variable vaut 1 ET qu'une
# clé est présente. Sans elle: extraction/génération simulées, aucune dépense.
FLASHCARDS_LLM_REEL=0

# Force le mode simulé partout, correction par IA comprise (1 = simulé).
MOCK_LLM=0

# Interrupteur d'urgence: 1 = aucun appel au modèle, refus explicite.
# (Aussi disponible sans redémarrage: `flashcards llm off` ou Réglages.)
LLM_DISABLED=0

# Plafonds durs, en USD. Vides = valeurs de config.toml (1.00 / 5.00 / 0.50).
# Au-delà de 5 / 20 / 2 USD, le serveur refuse de démarrer les appels tant que
# FLASHCARDS_PLAFONDS_ELEVES=1 n'est pas posé.
FLASHCARDS_COUT_MAX_JOUR=
FLASHCARDS_COUT_MAX_MOIS=
FLASHCARDS_COUT_MAX_OPERATION=
FLASHCARDS_APPELS_MAX_MINUTE=
